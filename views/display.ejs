<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DisplayDrop - Live Player</title>
    <link rel="stylesheet" href="/css/display.css">
</head>
<body>
    <div id="stage"></div>

    <div id="playerBar" class="player-bar" aria-hidden="true">
        <span class="player-badge">Area: <b id="playerAreaLabel">All slides</b></span>
        <label class="player-picker">
            <span>Show:</span>
            <select id="playerAreaSelect">
                <option value="">All slides</option>
                <% tags.forEach(t => { %>
                <option value="<%= t.name %>"><%= t.name %></option>
                <% }) %>
            </select>
        </label>
    </div>

    <script>
        let slides = [];
        let currentIndex = 0;
        let pendingTimeout = null;
        const stage = document.getElementById('stage');
        const activeTags = (new URLSearchParams(location.search).get('tags') || '')
            .split(',').map(s => s.trim()).filter(Boolean);
        const API_URL = '/api/slides' + (activeTags.length
            ? '?tags=' + activeTags.map(encodeURIComponent).join(',')
            : '');

        // Toggle Fullscreen Function
        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {
                    console.error(`Error attempting to enable full-screen mode: ${err.message}`);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        // 1. Double Click Listener
        document.addEventListener('dblclick', () => {
            toggleFullScreen();
        });

        // 2. Escape Key Listener
        // Note: Browsers automatically exit F11/Fullscreen on Escape,
        // but this ensures our app state handles it gracefully.
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && document.fullscreenElement) {
                document.exitFullscreen();
            }

            // Bonus: Press 'F' to toggle as well (common in video players)
            if (e.key.toLowerCase() === 'f') {
                toggleFullScreen();
            }
        });

        async function init() {
            const res = await fetch(API_URL);
            slides = await res.json();

            if (slides.length === 0) {
                stage.innerHTML = '<div style="color: white; padding: 20px;">No active slides found. Add images to the folder and enable them in the dashboard.</div>';
                return;
            }

            renderSlides();
            playNext();
        }

        function renderSlides() {
            // Smart update: preserve existing slides and only add/remove what changed
            const existingSlides = new Map();
            document.querySelectorAll('.slide').forEach(el => {
                const id = el.id;
                existingSlides.set(id, el);
            });

            slides.forEach((slide, index) => {
                const slideId = `slide-${index}`;
                const existingEl = existingSlides.get(slideId);

                if (existingEl) {
                    // Update existing slide if needed
                    const newBg = `url('/slides/${slide.filename}')`;
                    if (existingEl.style.backgroundImage !== newBg) {
                        existingEl.style.backgroundImage = newBg;
                    }
                    // Update transition class if changed
                    const transitionClasses = ['fade', 'slide-in', 'slide-left', 'slide-right', 'push', 'cut'];
                    const currentTransition = transitionClasses.find(t => existingEl.classList.contains(t));
                    if (currentTransition !== slide.transition) {
                        if (currentTransition) existingEl.classList.remove(currentTransition);
                        existingEl.classList.add(slide.transition);
                    }
                    existingSlides.delete(slideId); // Mark as processed
                } else {
                    // Add new slide
                    const div = document.createElement('div');
                    div.className = `slide ${slide.transition}`;
                    div.style.backgroundImage = `url('/slides/${slide.filename}')`;
                    div.id = slideId;
                    stage.appendChild(div);
                }
            });

            // Remove slides that no longer exist (but preserve active/previous ones temporarily)
            existingSlides.forEach((el, id) => {
                if (!el.classList.contains('active') && !el.classList.contains('previous')) {
                    el.remove();
                }
            });
        }

        function playNext() {
            if (pendingTimeout) {
                clearTimeout(pendingTimeout);
                pendingTimeout = null;
            }

            if (slides.length === 0) return;

            // 1. Find the current slide and prepare to phase it out
            const oldSlide = document.querySelector('.slide.active');
            if (oldSlide) {
                oldSlide.classList.remove('active');
                oldSlide.classList.add('previous');

                // CLEANUP: After the transition, remove the 'previous' class
                // For 'cut' transitions, this happens instantly (0ms)
                // For other transitions, wait for the animation (1.5s)
                const isCut = oldSlide.classList.contains('cut');
                const cleanupDelay = isCut ? 0 : 1600;
                setTimeout(() => {
                    oldSlide.classList.remove('previous');
                }, cleanupDelay);
            }

            // 2. Activate the new slide
            const nextEl = document.getElementById(`slide-${currentIndex}`);
            if (nextEl) {
                nextEl.classList.add('active');
            }

            // 3. Set timing for the next loop
            const currentSlideData = slides[currentIndex];
            const ms = (currentSlideData.duration || 5) * 1000;

            pendingTimeout = setTimeout(() => {
                currentIndex = (currentIndex + 1) % slides.length;
                playNext();
            }, ms);
        }

        // Check for updates every 5 seconds (Smoothly syncs changes without interruption)
        setInterval(async () => {
            try {
                const res = await fetch(API_URL);
                const newSlides = await res.json();

                const hasChanged = JSON.stringify(newSlides) !== JSON.stringify(slides);

                if (hasChanged) {
                    console.log("DisplayDrop: Update detected. Syncing new configuration...");

                    const prevSlideData = slides[currentIndex];
                    const wasShowing = prevSlideData && prevSlideData.filename;

                    slides = newSlides;

                    if (slides.length === 0) {
                        // Nothing to show anymore: stop the player cleanly
                        if (pendingTimeout) {
                            clearTimeout(pendingTimeout);
                            pendingTimeout = null;
                        }
                        const active = document.querySelector('.slide.active');
                        if (active) active.classList.remove('active');
                        return;
                    }

                    // Try to find the same slide in the new list to maintain continuity
                    const newIndex = wasShowing ? newSlides.findIndex(s => s.filename === wasShowing) : -1;

                    if (newIndex >= 0) {
                        currentIndex = newIndex;
                    } else {
                        // Current slide was removed: move on immediately instead of overstaying its window
                        currentIndex = Math.min(currentIndex, newSlides.length - 1);
                        renderSlides();
                        playNext();
                        return;
                    }

                    renderSlides(); // Smoothly update slides in the background without clearing the stage

                    // Re-time the current slide if its duration changed, so schedule changes apply right away
                    const fresh = slides[currentIndex];
                    if (fresh && prevSlideData && prevSlideData.duration !== fresh.duration) {
                        if (pendingTimeout) clearTimeout(pendingTimeout);
                        pendingTimeout = setTimeout(() => {
                            currentIndex = (currentIndex + 1) % slides.length;
                            playNext();
                        }, (fresh.duration || 5) * 1000);
                    }
                }
            } catch (e) {
                console.error("Connection lost to DisplayDrop server.");
            }
        }, 5000);

        // Area picker: hovering reveals a small bar to switch tag groups.
        const playerBar = document.getElementById('playerBar');
        const areaSelect = document.getElementById('playerAreaSelect');
        document.getElementById('playerAreaLabel').textContent = activeTags.length ? activeTags.join(', ') : 'All slides';
        areaSelect.value = activeTags.length === 1 ? activeTags[0] : '';

        let hideCursorTimer = null;
        document.addEventListener('mousemove', () => {
            stage.classList.remove('hide-cursor');
            playerBar.classList.add('show');
            clearTimeout(hideCursorTimer);
            hideCursorTimer = setTimeout(() => {
                stage.classList.add('hide-cursor');
                playerBar.classList.remove('show');
            }, 3000);
        });

        areaSelect.addEventListener('change', (e) => {
            const v = e.target.value;
            location.href = v ? `/play?tags=${encodeURIComponent(v)}` : '/play';
        });

        init();
    </script>
</body>
</html>
