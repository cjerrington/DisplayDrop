<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - DisplayDrop</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <% if (success) { %>
        <div class="login-card">
            <h1>DisplayDrop</h1>
            <p class="subtitle">Password reset</p>
            <p class="success-text">Your password has been updated. You can now <a href="/login">sign in</a>.</p>
        </div>
    <% } else { %>
        <form class="login-card" action="/reset-password" method="POST">
            <h1>DisplayDrop</h1>
            <p class="subtitle">Set a new password</p>

            <% if (error) { %>
                <p class="error-text"><%= error %></p>
            <% } %>

            <label>
                Reset Token
                <input type="text" name="token" value="<%= token %>" required autocomplete="off" autofocus>
            </label>

            <label>
                New Password
                <input type="password" name="password" required minlength="8" autocomplete="new-password">
            </label>

            <label>
                Confirm Password
                <input type="password" name="password_confirm" required minlength="8" autocomplete="new-password">
            </label>

            <button type="submit" class="btn primary btn-block">Set New Password</button>
            <p class="subtitle" style="margin-top: 1rem; margin-bottom: 0; font-size: 0.8rem;">
                Tokens are one-time use and expire after one hour.
            </p>
        </form>
    <% } %>
</body>
</html>
